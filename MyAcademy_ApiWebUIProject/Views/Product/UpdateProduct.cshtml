@using MyAcademy_ApiWebUIProject.Dtos.ProductDtos
@model UpdateProductDto
@{
    Layout = null;
    ViewData["Title"] = "Ürün Güncelle";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h4>Ürün Güncelle</h4>
                    <p class="text-muted mb-0">
                        Ürün bilgilerini eksiksiz şekilde doldurun.
                    </p>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="ProductId" />
                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label">Ürün Adı</label>
                            <input asp-for="ProductName" class="form-control" placeholder="Ürün adını giriniz" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProductStock" class="form-label">Stok Miktarı</label>
                            <input asp-for="ProductStock" type="number" min="0" class="form-control" />
                            <span asp-validation-for="ProductStock" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProductPrice" class="form-label"> Ürün Fiyatı </label>
                            <input asp-for="ProductPrice" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="ProductPrice" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsCritic" class="form-check-input" type="checkbox" />
                            <label asp-for="IsCritic" class="form-check-label"> Kritik Ürün </label>
                        </div>

                        <button type="submit" class="btn btn-success"> Ürünü Güncelle </button>

                        <a asp-controller="Product" asp-action="ProductList" class="btn btn-secondary"> İptal </a>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>
