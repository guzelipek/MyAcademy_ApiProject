@using MyAcademy_ApiWebUIProject.Dtos.ProductDtos
@model List<ResultProductDto>
@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = null;
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Ürün Listesi</h3>
            <small class="text-muted">Sistemde kayıtlı ürünleri buradan yönetebilirsiniz.</small>
        </div>
        <a href="/Product/CreateProduct" class="btn btn-primary">+ Yeni Ürün</a>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Ürün Adı</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.ProductId</td>
                                <td>@product.ProductName</td>
                                <td>@product.ProductPrice</td>
                                <td>@product.ProductStock</td>  
                                <td>@(product.IsCritic ? "Aktif" : "Pasif")</td>
                                <td><a href="/Product/DeleteProduct/@product.ProductId" class="btn btn-danger">Sil</a><a href="/Product/UpdateProduct/@product.ProductId" class="btn btn-warning">Güncelle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
</div>